datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Equipo {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  direccion String
  logo      String?
  logoBin   Bytes?
  logoTipo  String?
  ciudad    String?
  estadio   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventosComoLocal     EventoCalendario[] @relation("equipo1")
  eventosComoVisitante EventoCalendario[] @relation("equipo2")

  @@map("equipos")
}

model Noticia {
  id                 Int      @id @default(autoincrement())
  titulo             String
  slug               String   @unique
  descripcionBreve   String
  descripcionDetalle String
  imagen             String
  imagenBin          Bytes?
  imagenTipo         String?
  categoria          String
  publicado          Boolean  @default(true)
  fecha              DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("noticias")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model IntentoLogin {
  id        Int      @id @default(autoincrement())
  ip        String
  usuario   String
  createdAt DateTime @default(now())

  @@index([ip])
  @@map("intentos_login")
}

model BloqueoLogin {
  ip            String    @id
  conteoFallas  Int       @default(0)
  bloqueadoHasta DateTime?
  actualizadoEn DateTime  @updatedAt

  @@map("bloqueo_login")
}

model EventoCalendario {
  id                 Int      @id @default(autoincrement())
  equipo1Id          Int
  equipo2Id          Int
  equipo1            Equipo   @relation("equipo1", fields: [equipo1Id], references: [id])
  equipo2            Equipo   @relation("equipo2", fields: [equipo2Id], references: [id])
  ubicacion          String
  descripcionBreve   String?
  descripcionDetalle String?
  imagen             String?
  categoria          String
  publicado          Boolean  @default(true)
  fecha              DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("calendario")
}
